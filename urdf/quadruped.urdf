<?xml version="1.0"?>
<!-- Legs-only model of the real quadruped, for ros2 launch depth 2_gazebo.launch.py robot:=quadruped.
     Derived from rover.urdf with the same body, legs, camera and IMU, but without the wheeled
     base (wheels, castors, lidar, diff_drive). Other differences -
     - base_link is the body centre, 0.19 m above base_footprint (walk_gait stand pose);
       legs 1 / 2 and the camera at +x, the direction walk_gait crawls
     - joints take effort from pid_controller (config/controllers_quadruped.yaml)
     - feet have full grip; odometry comes from the p3d ground-truth plugin
     Keep joint names and order in step with rover.urdf and controllers_quadruped.yaml -->
<robot name="quadruped">
  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.19" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <link name="camera">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.2 0 0.1" rpy="0 0.0 0.0" />
    <parent link="base_link" />
    <child link="camera" />
    <axis xyz="0.0 0.0 1.0" />
  </joint>
  <link name="camera_link_optical" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera" />
    <child link="camera_link_optical" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>
  <link name="body-v1">
    <inertial>
      <origin xyz="0.0 0.05999999999999999 0.0" rpy="0.0 0.0 0.0" />
      <mass value="2.543399999999999" />
      <inertia ixx="0.04768874999999999" iyy="0.2079229499999999" izz="0.2212757999999999" ixy="0.0" iyz="0.0" ixz="-4.5693013817071915e-17" />
