<?xml version='1.0'?>
<!-- Quadruped alone (no rover), the same body, legs and camera as in rover.urdf.
     base_link is the body centre (middle of the four hips), x forward, y left, z up,
     like base_link in rover.urdf. The CAD body is quad_body (origin at a body corner, front = +Y).
     Spawned by 2_gazebo.launch.py robot:=quadruped.
     Never write a colon followed by a space in this file (breaks gazebo_ros2_control) -->
<robot name="quadruped">

    <link name="base_link"/>

    <!-- Body centre (-0.0679, 0.0662, 0.0249 in quad_body) over base_link, the body's
         front (+Y, legs 3 and 4, camera) along base_link +x. Same turn as botbase in rover.urdf -->
    <joint name="botbase" type="fixed">
        <parent link="base_link"/>
        <child link="quad_body"/>
        <origin xyz="-0.06616426 -0.06793669 -0.02487182" rpy="0 0 -1.5707963267948966"/>
    </joint>

    <link name="quad_body">
        <inertial>
            <origin xyz="-0.06846291142541326 0.06523369045476954 0.048349572714112894" rpy="0.0 0.0 0.0" />
            <mass value="1.1019792335974774" />
