<sdf version="1.6">
  <world name="default">

    <!-- Ground -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Your A1 environment -->
    <include>
      <uri>model://A1</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
