            </geometry>
        </visual>
        <collision name="leg33_collision">
            <origin xyz="0.19999999709221558 0.05000000381166603 2.877698079828406e-15" rpy="1.5707963267949112 2.5069503642851463e-15 -1.5707963267948986" />
            <geometry>
                <mesh filename="package://depth/meshes/leg33.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

    <joint name="botbase" type="fixed">
    <parent link="base_link"/>
    <child link="body-v1"/>
    <origin xyz="0 0.05 0.3" rpy="0 0 3.14"/>
    </joint>

<joint name="CCUP1" type="revolute">
        <origin xyz="-0.15 0.0 -0.045" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="body-v1" />
        <child link="leg11" />
        <axis xyz="0.0 0.0 1.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="CCUP4" type="revolute">
        <origin xyz="0.15 0.0 -0.045" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="body-v1" />
        <child link="leg41" />
        <axis xyz="0.0 0.0 1.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="CCUP3" type="revolute">
        <origin xyz="0.15 0.12 -0.045" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="body-v1" />
        <child link="leg31" />
        <axis xyz="0.0 0.0 1.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="CCUP2" type="revolute">
        <origin xyz="-0.15 0.12 -0.045" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="body-v1" />
        <child link="leg21" />
        <axis xyz="0.0 0.0 1.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="FOOT4" type="revolute">
        <origin xyz="-0.000992449999999998 0.01 0.10466176" rpy="1.5707963267948966 -4.7302613557769027e-32 -1.9721522630525295e-31" />
        <parent link="leg42" />
        <child link="leg43" />
        <axis xyz="1.9721522630525295e-31 9.860761315262648e-32 1.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="FOOT1" type="revolute">
        <origin xyz="-7.906999999999443e-05 0.01 0.10466642999999999" rpy="1.5707963267948966 5.551115123125783e-17 1.976004122941304e-31" />
        <parent link="leg12" />
        <child link="leg13" />
        <axis xyz="-1.9721522630525295e-31 3.944304526105059e-31 1.0000000000000002" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="FOOT2" type="revolute">
        <origin xyz="-7.906999999999443e-05 -0.01 0.10466642999999999" rpy="1.5707963267948966 -5.010913000762207e-33 0.0" />
        <parent link="leg22" />
        <child link="leg23" />
        <axis xyz="0.0 2.9582283945787943e-31 0.9999999999999999" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="FOOT3" type="revolute">
        <origin xyz="-7.906999999999443e-05 -0.01 0.10466642999999999" rpy="1.5707963267948966 -5.551115123125784e-17 -3.659266894335748e-32" />
        <parent link="leg32" />
        <child link="leg33" />
        <axis xyz="3.697785493223493e-32 1.355854680848614e-31 0.9999999999999998" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="THIGH1" type="revolute">
        <origin xyz="0.005 -0.05 -0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
        <parent link="leg11" />
        <child link="leg12" />
        <axis xyz="-3.851859888774472e-34 1.0 0.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="THIGH4" type="revolute">
        <origin xyz="0.005 -0.05 0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
        <parent link="leg41" />
        <child link="leg42" />
        <axis xyz="0.0 1.0 0.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="THIGH2" type="revolute">
        <origin xyz="0.005 0.05 -0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
        <parent link="leg21" />
        <child link="leg22" />
        <axis xyz="0.0 -1.0 0.0" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>
    <joint name="THIGH3" type="revolute">
        <origin xyz="0.005 0.05 0.05" rpy="3.141592653589793 1.5707963267948966 0" />
        <parent link="leg31" />
        <child link="leg32" />
        <axis xyz="3.851859888774472e-34 -1.0 -6.162975822039155e-33" />
        <dynamics damping="0.2" friction="0.0"/>
              <limit lower="-3.14" upper="3.14" effort="50" velocity="5"/>
    </joint>

    <ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <!-- Leg 1 -->
  <joint name="CCUP1">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="THIGH1">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="FOOT1">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 2 -->
  <joint name="CCUP2">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="THIGH2">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="FOOT2">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 3 -->
  <joint name="CCUP3">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="THIGH3">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="FOOT3">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 4 -->
  <joint name="CCUP4">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="THIGH4">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="FOOT4">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

</ros2_control>
<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
   <!-- DEPTH_SHARE_DIR is replaced with the package share path by the launch files -->
   <parameters>DEPTH_SHARE_DIR/config/controllers.yaml</parameters>
   </plugin>
</gazebo>

<!-- Castors are frictionless so they slide instead of dragging -->
<gazebo reference="front_castor_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>
<gazebo reference="back_castor_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<!-- Drive wheels get full grip with stiff, damped contact -->
<gazebo reference="wheel_front_left">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1e6</kp>
  <kd>100</kd>
  <minDepth>0.001</minDepth>
</gazebo>
<gazebo reference="wheel_front_right">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1e6</kp>
  <kd>100</kd>
  <minDepth>0.001</minDepth>
</gazebo>

<!-- DIFFENERNTIAL DRIVEEEEEEEEEEEEE -->

  <gazebo>
<plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
        <left_joint>wheel_front_left_joint</left_joint>
        <right_joint>wheel_front_right_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_diameter>0.10</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>2.0</max_wheel_acceleration>
        <!-- 0 = encoder, 1 = world (ground truth) -->
        <odometry_source>1</odometry_source>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>

      </plugin>
</gazebo>

 <gazebo reference="camera">
  <sensor name="camera" type="depth">
    <update_rate>30</update_rate>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>10.0</far>
      </clip>
    </camera>

    <plugin name="gazebo_ros_camera"
            filename="libgazebo_ros_camera.so">

      <ros>
        <namespace>/camera</namespace>
      </ros>

      <camera_name>camera</camera_name>
      <frame_name>camera_link_optical</frame_name>

    </plugin>
  </sensor>
</gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>

    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </z>
      </angular_velocity>

      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>

    <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
      <ros>
        <namespace>/imu</namespace>
      </ros>
      <frame_name>imu_link</frame_name>
    </plugin>

  </sensor>
</gazebo>
</robot>
