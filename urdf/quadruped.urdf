        <!-- In the front socket (95.5 x 32 mm opening in the front plate), centred in the
             opening, resting on its ledge (z 0.0249), front face flush with the plate (y 0.2452) -->
        <origin xyz="-0.0679 0.2327 0.0374" rpy="0 0 1.5707963267948966" />
        <parent link="quad_body" />
        <child link="camera" />
    </joint>
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
        <parent link="camera" />
        <child link="camera_link_optical" />
    </joint>

    <ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <!-- position_pid, Gazebo turns the position command into joint torque with these gains.
       Plain position teleports the joints every step, which makes the robot explode
       once the feet touch the ground. The controller still uses the position interface -->

  <!-- Leg 1 -->
  <joint name="base_link_Revolute_1">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_3_Revolute_31">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_3_Revolute_32">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 2 -->
  <joint name="base_link_Revolute_3">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_2_Revolute_28">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_2_Revolute_29">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 3 -->
  <joint name="base_link_Revolute_4">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_1_Revolute_25">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_1_Revolute_26">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 4 -->
  <joint name="base_link_Revolute_2">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_4_Revolute_34">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_4_Revolute_35">
    <command_interface name="position_pid"/>
    <param name="pos_kp">60</param>
    <param name="pos_kd">1.5</param>
    <state_interface name="position"/>
  </joint>

</ros2_control>
<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
   <!-- DEPTH_SHARE_DIR is replaced with the package share path by the launch files -->
   <!-- Off, otherwise the joints are forced to zero velocity until the controller starts,
        which throws the robot around when it lands -->
   <hold_joints>false</hold_joints>
   <parameters>DEPTH_SHARE_DIR/config/controllers.yaml</parameters>
   </plugin>
</gazebo>

    <!-- Depth camera sensor, Publishes /camera/camera/image_raw,
         /camera/camera/depth/image_raw, /camera/camera/points and camera_info -->
    <gazebo reference="camera">
        <sensor name="camera" type="depth">
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/camera</namespace>
                </ros>
                <camera_name>camera</camera_name>
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Feet, high grip with soft, damped contact. Without this the feet jitter on the
         ground and the robot slowly slides while standing -->
    <gazebo reference="foot_1">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>100</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.0</maxVel>
    </gazebo>
    <gazebo reference="foot_2">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>100</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.0</maxVel>
    </gazebo>
    <gazebo reference="foot_3">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>100</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.0</maxVel>
    </gazebo>
    <gazebo reference="foot_4">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>100</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.0</maxVel>
    </gazebo>
</robot>
