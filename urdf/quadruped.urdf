    <limit lower="-3.14" upper="3.14" effort="50" velocity="5" />
  </joint>
  <joint name="THIGH1" type="revolute">
    <origin xyz="0.005 -0.05 -0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
    <parent link="leg11" />
    <child link="leg12" />
    <axis xyz="-3.851859888774472e-34 1.0 0.0" />
    <dynamics damping="0.2" friction="0.0" />
    <limit lower="-3.14" upper="3.14" effort="50" velocity="5" />
  </joint>
  <joint name="THIGH4" type="revolute">
    <origin xyz="0.005 -0.05 0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
    <parent link="leg41" />
    <child link="leg42" />
    <axis xyz="0.0 1.0 0.0" />
    <dynamics damping="0.2" friction="0.0" />
    <limit lower="-3.14" upper="3.14" effort="50" velocity="5" />
  </joint>
  <joint name="THIGH2" type="revolute">
    <origin xyz="0.005 0.05 -0.05" rpy="-3.141592653589793 1.5707963267948966 0" />
    <parent link="leg21" />
    <child link="leg22" />
    <axis xyz="0.0 -1.0 0.0" />
    <dynamics damping="0.2" friction="0.0" />
    <limit lower="-3.14" upper="3.14" effort="50" velocity="5" />
  </joint>
  <joint name="THIGH3" type="revolute">
    <origin xyz="0.005 0.05 0.05" rpy="3.141592653589793 1.5707963267948966 0" />
    <parent link="leg31" />
    <child link="leg32" />
    <axis xyz="3.851859888774472e-34 -1.0 -6.162975822039155e-33" />
    <dynamics damping="0.2" friction="0.0" />
    <limit lower="-3.14" upper="3.14" effort="50" velocity="5" />
  </joint>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <!-- Leg 1 -->
    <joint name="CCUP1">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="THIGH1">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-1.4002</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FOOT1">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-0.46137</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <!-- Leg 2 -->
    <joint name="CCUP2">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="THIGH2">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">1.4002</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FOOT2">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-0.46137</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <!-- Leg 3 -->
    <joint name="CCUP3">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="THIGH3">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">1.4002</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FOOT3">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-0.46137</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <!-- Leg 4 -->
    <joint name="CCUP4">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="THIGH4">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-1.4002</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FOOT4">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">-0.46137</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <!-- DEPTH_SHARE_DIR is replaced with the package share path by the launch files -->
      <parameters>DEPTH_SHARE_DIR/config/controllers_quadruped.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- Feet get full grip -->
  <gazebo reference="leg13">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="leg23">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="leg33">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="leg43">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- Ground-truth pose of the body (replaces the diff_drive odometry). ground_truth_odom turns it into /odom and TF odom to base_footprint -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
  <gazebo reference="camera">
    <sensor name="camera" type="depth">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/imu</namespace>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
