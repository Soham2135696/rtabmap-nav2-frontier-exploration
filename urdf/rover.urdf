<?xml version='1.0'?>
<robot name="rover">
  <link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>
  <link name="base_link">
    <visual>
      <geometry>
          <box size=".2 0.2 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba=".2 .2 .2 1" />
      </material>
    </visual>
  <inertial>
            <mass value="2" />
            <inertia ixx="0.04" ixy="0.0" ixz="0" 
            iyy="0.17" iyz="0" izz="0.25" />
    </inertial>
    
    <collision>
      <geometry>
          <box size=".2 0.2 0.1"/>
      </geometry>
    </collision>
  </link>


  <link name="wheel_front_right">
    <inertial>
            <mass value="2" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0" 
            iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>
      
      <geometry>
          <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
    
      <geometry>
          <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_front_right_joint" type="continuous">
    <origin xyz="0 -0.15 -0.05" rpy="-1.5708 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <link name="wheel_front_left">
    <inertial>
            <mass value="2" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0" 
            iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>
      
      <geometry>
          <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
          <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_front_left_joint" type="continuous">
    <origin xyz="0 0.15 -0.05" rpy="-1.5708 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="back_castor_wheel">
    <inertial>
            <mass value="2" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0" 
            iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>
      
      <geometry>
          <sphere radius="0.05"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <!-- 2 mm smaller than the visual so the drive wheels carry the weight -->
      <geometry>
          <sphere radius="0.048"/>
      </geometry>
    </collision>
  </link>

  <joint name="castor_wheel_joint" type="fixed">
    <origin xyz="-0.15 0 -0.05" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="back_castor_wheel"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="front_castor_wheel">
    <inertial>
            <mass value="2" />
            <inertia ixx="1e-3" ixy="0.0" ixz="0" 
            iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>
      
      <geometry>
          <sphere radius="0.05"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <!-- 2 mm smaller than the visual so the drive wheels carry the weight -->
      <geometry>
          <sphere radius="0.048"/>
      </geometry>
    </collision>
  </link>

  <joint name="castor_wheel_joint_2" type="fixed">
    <origin xyz="0.15 0 -0.05" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="front_castor_wheel"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>


    <link name="imu_link">
  <inertial>
    <mass value="0.1"/>
    <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
             iyy="1e-5" iyz="0.0"
             izz="1e-5"/>
  </inertial>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0.2" rpy="0 0 0"/>
</joint>


  <!-- ================= Quadruped body (same model as urdf.urdf / quadruped.urdf) =================
       Its base_link is renamed quad_body. Its front (+Y, legs 3 and 4, camera) faces the
       rover's +x, and the body centre (-0.068, 0.068 in quad_body) sits over base_link -->
  <joint name="botbase" type="fixed">
    <parent link="base_link"/>
    <child link="quad_body"/>
    <origin xyz="-0.068 -0.068 0.3" rpy="0 0 -1.5707963267948966"/>
  </joint>
    <link name="quad_body">
        <inertial>
            <origin xyz="-0.06846291142541326 0.06523369045476954 0.048349572714112894" rpy="0.0 0.0 0.0" />
            <mass value="1.1019792335974774" />
            <inertia ixx="0.015414636292325663" iyy="0.007970512607825653" izz="0.018652708753433382" ixy="-6.253895842451857e-05" iyz="-3.2225259479632534e-05" ixz="-4.342837838612222e-05" />
