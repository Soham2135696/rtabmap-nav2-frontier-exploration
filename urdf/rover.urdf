    </joint>
    <joint name="camera_joint" type="fixed">
        <!-- In the front socket (95.5 x 32 mm opening in the front plate), centred in the
             opening, resting on its ledge (z 0.0249), front face flush with the plate (y 0.2452) -->
        <origin xyz="-0.0679 0.2327 0.0374" rpy="0 0 1.5707963267948966" />
        <parent link="quad_body" />
        <child link="camera" />
    </joint>
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
        <parent link="camera" />
        <child link="camera_link_optical" />
    </joint>

    <ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <!-- Leg 1 -->
  <joint name="base_link_Revolute_1">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_3_Revolute_31">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_3_Revolute_32">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 2 -->
  <joint name="base_link_Revolute_3">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_2_Revolute_28">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_2_Revolute_29">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 3 -->
  <joint name="base_link_Revolute_4">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_1_Revolute_25">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_1_Revolute_26">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <!-- Leg 4 -->
  <joint name="base_link_Revolute_2">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="ccup_4_Revolute_34">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
  <joint name="thigh_4_Revolute_35">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

</ros2_control>
<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
   <!-- DEPTH_SHARE_DIR is replaced with the package share path by the launch files -->
   <parameters>DEPTH_SHARE_DIR/config/controllers.yaml</parameters>
   </plugin>
</gazebo>

<!-- Castors are frictionless so they slide instead of dragging -->
<gazebo reference="front_castor_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>
<gazebo reference="back_castor_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<!-- Drive wheels get full grip with stiff, damped contact -->
<gazebo reference="wheel_front_left">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1e6</kp>
  <kd>100</kd>
  <minDepth>0.001</minDepth>
</gazebo>
<gazebo reference="wheel_front_right">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1e6</kp>
  <kd>100</kd>
  <minDepth>0.001</minDepth>
</gazebo>

<!-- Differential drive -->

  <gazebo>
<plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
        <left_joint>wheel_front_left_joint</left_joint>
        <right_joint>wheel_front_right_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_diameter>0.10</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>2.0</max_wheel_acceleration>
        <!-- 0 = encoder, 1 = world (ground truth) -->
        <odometry_source>1</odometry_source>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>

      </plugin>
</gazebo>


    <!-- Depth camera sensor, same settings as rover.urdf. Publishes /camera/camera/image_raw,
         /camera/camera/depth/image_raw, /camera/camera/points and camera_info -->
    <gazebo reference="camera">
        <sensor name="camera" type="depth">
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/camera</namespace>
                </ros>
                <camera_name>camera</camera_name>
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>

    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </z>
      </angular_velocity>

      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>

    <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
      <ros>
        <namespace>/imu</namespace>
        <remapping>~/out:=data</remapping>
      </ros>
      <frame_name>imu_link</frame_name>
    </plugin>

  </sensor>
</gazebo>
</robot>
